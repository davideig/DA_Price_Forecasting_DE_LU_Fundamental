# Copy this file to .env and add the credentials needed for your workflow.

# Required for downloading current ENTSO-E data.
ENTSOE_API_KEY=

# Optional. Leave empty to use Open-Meteo's public non-commercial endpoint.
OPEN_METEO_API_KEY=

# Optional. Only required when using forecast-next-day --submit.
ENERGY_ARENA_API_KEY=
ENERGY_ARENA_PRICE_CHALLENGE_ID=
ENERGY_ARENA_LOAD_CHALLENGE_ID=
ENERGY_ARENA_SOLAR_CHALLENGE_ID=
ENERGY_ARENA_WIND_CHALLENGE_ID=
