# Copy this file to .env and fill in your credentials.
ENTSOE_API_KEY=your_entsoe_api_key_here
ENERGY_ARENA_API_KEY=your_energy_arena_api_key_here
ENERGY_ARENA_PRICE_CHALLENGE_ID=your_price_challenge_id_here
ENERGY_ARENA_PRICE_QUANTILE_CHALLENGE_ID=your_probabilistic_price_challenge_id_here
ENERGY_ARENA_PRICE_CUTOFF_0700_CHALLENGE_ID=your_0700_price_cutoff_challenge_id_here
ENERGY_ARENA_PRICE_CUTOFF_0800_CHALLENGE_ID=your_0800_price_cutoff_challenge_id_here
ENERGY_ARENA_PRICE_CUTOFF_0900_CHALLENGE_ID=your_0900_price_cutoff_challenge_id_here
ENERGY_ARENA_PRICE_CUTOFF_1000_CHALLENGE_ID=your_1000_price_cutoff_challenge_id_here
ENERGY_ARENA_PRICE_CUTOFF_1100_CHALLENGE_ID=your_1100_price_cutoff_challenge_id_here
ENERGY_ARENA_PRICE_CUTOFF_1200_CHALLENGE_ID=your_1200_price_cutoff_challenge_id_here
ENERGY_ARENA_LOAD_CHALLENGE_ID=your_load_challenge_id_here
ENERGY_ARENA_LOAD_QUANTILE_CHALLENGE_ID=your_probabilistic_load_challenge_id_here
ENERGY_ARENA_SOLAR_CHALLENGE_ID=your_solar_generation_challenge_id_here
ENERGY_ARENA_WIND_CHALLENGE_ID=your_wind_generation_challenge_id_here
# Open-Meteo customer API key. Open-Meteo configs read this via
# `open_meteo_api_key_env: OPEN_METEO_API_KEY`; do not paste the key into YAML.
OPEN_METEO_API_KEY=your_open_meteo_api_key_here
DWD_ICON_LSDF_BASE=/path/to/mounted/lsdf/icon_by_Max_Kleinebrahm
PRIOR_API_KEY=your_prior_api_key_here
